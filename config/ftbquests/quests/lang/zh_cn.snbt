	quest.2A4225B4370512D8.title: "Wololo！染色！"
	quest.2CA494DF6B2CC150.quest_desc: ["除了紫水晶外，还存在黄水晶和托帕石两种水晶，地表、地下都有可能生成"]
	quest.2CA494DF6B2CC150.quest_subtitle: "还有高手？"
	quest.2CD176392654CC71.quest_desc: ["&e干海带&r是制作各种元件的重要原料，本章节主要用于生产&b传送带&r和&b安山漏斗&r"]
	quest.3060868EC927C45F.quest_desc: ["可以把&e纸板&r放到&b压缩抽屉&r里，这样就可以自动转化为&e纸板块&r了"]
	quest.3060868EC927C45F.quest_subtitle: "打包带走"
	quest.32595D717E66D50D.quest_subtitle: "神奇动物在哪里？"
	quest.33C0C5C5B5ADB815.quest_desc: [
		"&e玄武岩三角洲&r的&b跨座兽&r是一种&c非常烦人的存在&r"
		""
		"&6被铁砧砸死的跨座蝌蚪可以将下方3x2x3区域的下界岩和下界尘转化为&e跨座蝌蚪残骸&r"
		"&7（1次转化1个，优先级为上>下，南>北>东>西）"
		""
		"&e跨座蝌蚪残骸&r上方放上&b炽热水晶&r，再用铁砧加工一下，就可以产生&e绯红矿石&r！"
		"&7（绯红矿石也可以在下界自然生成）"
