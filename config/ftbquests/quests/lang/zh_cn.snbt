	quest.5B7B949739EA3ED5.quest_desc: ["&9仪式火盆&r可以进行各种奇奇怪怪但是实用的仪式，下面给出了前期&e无需魔源&r的实用仪式"]
	quest.5C0D9EC86060936C.quest_desc: [
