	quest.02863465E853724C.quest_desc: [
		"你需要一个&b研究实验室&r来进行研究，来解锁后续的科技和配方"
		"&7（研究的页面默认按\"打开）"
	]
	quest.02863465E853724C.title: "第一个研究包！"
	quest.05064BEC5C7DF9F4.quest_desc: [
		"章节分为5类："
		"&e科技主线、科技支线、魔法主线、魔法支线和混合线"
		"其中混合线的定位是科技和魔法共有的支线"
		""
		"章节的名字也有其含义，下面给出部分例子："
		"&d0-启程&r，它是名为“启程”第0个章节"
		""
		"&d8-I-新建文件夹&r是第8章主线的其中一个主线章节"
		""
		"&d1a-未命名&r是第1章主线支线章节的其中一个"
		""
		"&d1-7-暴君&r是第1章科技主线和第7章魔法主线混合线章节"
	]
	quest.05064BEC5C7DF9F4.title: "关于章节介绍"
	quest.058AD91A0A40F254.quest_desc: [
		"在&b动力锯&r上，&e1块&r安山合金可以切出&e6根&r传动杆！"
