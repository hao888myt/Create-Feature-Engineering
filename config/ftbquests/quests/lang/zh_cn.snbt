	quest.443C49B551AA6BEC.quest_desc: ["用&b动力搅拌器&r搅拌，&e原料利用率&r更高哦"]
	quest.44D8620D8289DB2D.quest_desc: [
		"这是一个以机械动力(Create)、铁砧工艺（AnvilCraft）、光谱世界（Spectrum）、新生魔艺（Ars Nouveau）为核心的&e科技整合包&r。"
		""
		"在该整合包，你可以跟随任务的指引，运用各种各样&e原有的&r或&z全新的特性&r来制造各种各样的产线。"
		""
		"&e音波转化、方块运输&r...等等等等，各种自定义的特性等着你来探索与发掘！"
	]
	quest.44D8620D8289DB2D.quest_subtitle: "老大我们这样真的可以拉到新人吗"
	quest.44D8620D8289DB2D.title: "欢迎来到机械动力：特性工程！"
	quest.47E68A49C36A7AA3.title: "开垦与收割"
	quest.486C7F82AAD86015.title: "至高树苗"
	quest.4B1EC6BB72C4DE14.quest_desc: [
		"&e原版&r和&e机械动力刷铁机&r的&c效率实在是太低了&r，有没有什么更快更好的刷铁机？"
		""
		"有的兄弟有的"
		"我们可以用&e铁砧工艺&r的&9铁砧抢夺机制&r来制作刷铁机"
		""
		"当一个生物受到铁砧伤害的时："
		"如果伤害大于生命值上限的40%，会掉落1倍的掉落物"
		"60%是2倍，80%是3倍"
		"{@pagebreak}"
		"循环如下"
		"1.铁砧抢夺铁傀儡"
		"2.铁傀儡的铁锭修复铁傀儡，回到步骤1"
		""
		"铁砧下落高度+1，伤害+2，最高40点"
		"1个铁锭可以恢复铁傀儡25点血量"
	]
	quest.4B1EC6BB72C4DE14.quest_subtitle: "左脚踩右脚升天"
	quest.4B1EC6BB72C4DE14.title: "新时代刷铁机"
	quest.4BA9F71BF6BC48F2.quest_subtitle: "我这把刀上可是涂了剧毒哦（舔）"
