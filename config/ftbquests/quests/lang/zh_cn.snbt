	quest.0A02C90B85481DB1.quest_desc: [
		"&b火山魔源&r通道可以&e通过燃烧物品产生魔源&r"
		"工作周期为20gt"
		"&6并累积进度,在随机刻触发或消耗物品的时候转化下方3x3方块&7（优先级：西>北>东>南）"
		""
		"进度 >= 8"
		"下方方块为&e石头或者带有标签#c:stones&r"
		"将其转换为&e岩浆块&r，进度-8"
		""
		"进度 >= 12"
		"下方方块为&e岩浆块&r&7（优先级高）&r"
		"将其转换为&e熔岩&r，进度-12"
		""
		"设产生的魔源为s，燃料的燃烧时间为t，增加的进度为p"
		"公式如下："
		"&e燃料&r："
		"s = t / 12，p = 1"
		"&e岩浆桶&r&7（返还桶）&r："
		"s = t / 12 = 1666，p = 1"
		"&e烈焰至高木&r&7（不可去皮）&r："
		"s = t / 12 + 100 = 125，p = 12"
		"&e其它至高木&r："
		"s = t / 12 + 50 = 75，p = 8"
		"&e火之精华&r： "
		"s = 2500， p = 2"
	]
	quest.0A607FD0C954AC89.quest_subtitle: "让无生命的物体开开智"
	quest.0B7B2EF79E473657.quest_desc: ["&b安山漏斗&r可以&65gt输出1次物品&r，单个&b安山漏斗&r即可满足单个&b机械手&r的输入需求"]
	quest.0B7B2EF79E473657.title: "好快的漏斗"
	quest.0CD7119D43A5DB42.quest_desc: [
		"&e魔源宝石&r和&e魔源石&r是魔法线的基本材料，后续合成会大量用到"
		"魔源宝石可以通过&b粉碎之魔符&r粉碎&e水晶块&r获得&7（不是磨制水晶块）&r"
		"而魔源石可以用&e石头和魔源宝石&r在&b工作台&r上合成"
