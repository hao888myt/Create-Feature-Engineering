	quest.40A6A23ECCD49D95.quest_subtitle: "这可高效多了"
	quest.40A6A23ECCD49D95.title: "高效配方"
	quest.413E692EF168D55A.quest_subtitle: "滚滚而来"
	quest.4238F72FCB243CC1.quest_desc: ["原木通过&b冲压&r或者&b铁砧粉碎&r可以获得&e树脂和木质纤维&r"]
	quest.4238F72FCB243CC1.quest_subtitle: "好像上一章就该做树场了..."
	quest.4238F72FCB243CC1.title: "原木浑身都是宝"
	quest.44183795B328B39C.quest_desc: [
